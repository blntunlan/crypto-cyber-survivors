{
  "name": "crypto-survivors",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-docs.js && tsx scripts/generate-sitemap.ts && vite --open",
    "build": "node scripts/sync-docs.js && tsx scripts/generate-sitemap.ts && vite build",
    "docs:sync": "node scripts/sync-docs.js",
    "docs:check": "node scripts/check-docs-navigation.mjs",
    "start": "node server.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ui": "tsx scripts/check-ui-contract.ts",
    "check:ui-contract": "tsx scripts/check-ui-contract.ts --ci",
    "audit:client-server": "node scripts/run-client-server-audit.mjs",
    "audit:contracts": "tsx scripts/audit-contracts.ts",
    "typecheck": "tsc --noEmit --pretty false",
    "check:architecture": "node scripts/check-singleton-regressions.mjs",
    "check:reset-coverage": "node scripts/check-reset-coverage.mjs",
    "check:event-contract": "node scripts/check-event-contract.mjs",
    "check:beta-env": "tsx scripts/check-beta-env.ts",
    "generate:director-manifest": "tsx scripts/generate-director-manifest.ts",
    "check:director-manifest": "tsx scripts/generate-director-manifest.ts --check",
    "test:director-release": "vitest run tests/services/director tests/services/engagement/IntensityModel.test.ts tests/services/presentation --pool=forks --maxWorkers=1",
    "check:release-gate": "npm run check:baseline && npm run test:director-release",
    "check:baseline": "npm run typecheck && npm run check:architecture && npm run check:reset-coverage && npm run check:event-contract && npm run check:ui-contract && npm run check:director-manifest && npm run lint && npm run test && npm run build",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:audit": "node scripts/test-audit.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e:prepare": "node scripts/ensure-playwright-browsers.mjs chromium firefox webkit",
    "test:e2e:prepare:chromium": "node scripts/ensure-playwright-browsers.mjs chromium",
    "pretest:e2e": "npm run test:e2e:prepare",
    "test:e2e": "playwright test",
    "pretest:e2e:beta:critical": "npm run test:e2e:prepare:chromium",
    "test:e2e:beta:critical": "playwright test e2e/beta-smoke.spec.ts --project=chromium --project=mobile-chrome --workers=2",
    "pretest:e2e:beta:quality": "npm run test:e2e:prepare:chromium",
    "test:e2e:beta:quality": "playwright test e2e/a11y/accessibility.spec.ts e2e/network-error.spec.ts e2e/performance/fps.spec.ts --project=chromium --grep-invert \"Memory Management\"",
    "pretest:e2e:beta:matrix": "npm run test:e2e:prepare",
    "test:e2e:beta:matrix": "playwright test e2e/beta-smoke.spec.ts --project=chromium --project=mobile-chrome --project=firefox --project=webkit",
    "pretest:e2e:triage": "npm run test:e2e:prepare:chromium",
    "test:e2e:triage": "node scripts/run-e2e-triage.mjs",
    "pretest:e2e:ui-contract": "npm run test:e2e:prepare:chromium",
    "test:e2e:ui-contract": "playwright test --config=playwright.ui-contract.config.ts",
    "pretest:e2e:ui-contract:update": "npm run test:e2e:prepare:chromium",
    "test:e2e:ui-contract:update": "playwright test --config=playwright.ui-contract.config.ts --update-snapshots",
    "pretest:e2e:ui": "npm run test:e2e:prepare",
    "test:e2e:ui": "playwright test --ui",
    "pretest:e2e:debug": "npm run test:e2e:prepare",
    "test:e2e:debug": "playwright test --debug",
    "pretest:e2e:headed": "npm run test:e2e:prepare",
    "test:e2e:headed": "playwright test --headed",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "docs:clean": "rimraf docs/api",
    "prepare": "husky",
    "railway:link": "railway link",
    "railway:deploy": "railway up",
    "railway:market:deploy": "cd railway-market-server && railway up",
    "cloudflare:pages:deploy": "npm run build && npx --yes wrangler@4.76.0 pages deploy ./dist --project-name crypto-cyber-survivors --branch main",
    "cloudflare:pages:deploy:preview": "npm run build && npx --yes wrangler@4.76.0 pages deploy ./dist --project-name crypto-cyber-survivors --branch preview",
    "cloudflare:whoami": "npx --yes wrangler@4.76.0 whoami",
    "security:check": "node scripts/security-check.js",
    "indexnow:submit": "node scripts/submit-indexnow.mjs",
    "deploy": "git push origin main",
    "agy:delegate": "node scripts/agy-delegate.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "howler": "2.2.4",
    "lucide-react": "0.562.0",
    "motion-dom": "^13.1.1",
    "nanoid": "5.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "serve": "14.2.5",
    "tailwind-merge": "^3.4.0",
    "zod": "4.2.1",
    "zustand": "5.0.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/howler": "^2.2.12",
    "@types/node": "^22.19.7",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.16",
    "autoprefixer": "^10.4.23",
    "axe-core": "^4.11.1",
    "dotenv": "^17.2.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "glob": "^13.0.6",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "lint-staged": "^16.2.7",
    "msw": "^2.12.7",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "tailwindcss": "^3.4.19",
    "terser": "^5.46.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.15",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^6.4.1",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "!(public|coverage|dist|node_modules|playwright-report|test-results|remotion-video|.agent|.agents)/**/*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write",
      "vitest related --run --pool=forks --maxWorkers=1 --bail=1"
    ],
    "components/**/*.tsx": [
      "tsx scripts/check-ui-contract.ts --ci"
    ],
    "railway-market-server/src/**/*.ts": [
      "node scripts/run-market-typecheck.js"
    ],
    "!(public|coverage|dist|node_modules|playwright-report|test-results|remotion-video|.agent|.agents)/**/*.{json,css}": [
      "prettier --write"
    ],
    "!(public|coverage|dist|node_modules|playwright-report|test-results|remotion-video|.agent|.agents)/**/*.md": [
      "prettier --write"
    ]
  }
}
