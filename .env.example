# ============================================================
# CRYPTO SURVIVORS - ENVIRONMENT VARIABLES
# ============================================================
# IMPORTANT: Never commit actual values to Git.
# Copy this file to .env and fill in real values for local development.

# --- Supabase Configuration (Auth Only) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- App Environment ---
VITE_APP_ENV=development

# --- Railway API ---
VITE_RAILWAY_API_URL=https://your-api.up.railway.app
VITE_MARKET_AGGREGATOR_URL=https://your-aggregator.up.railway.app

# --- Market Runtime Mode ---
# legacy: current authority path
# dual: legacy authority + shadow runtime telemetry
# runtime: reserved for full runtime authority
VITE_MARKET_RUNTIME_MODE=legacy

# --- Twitter OAuth 2.0 ---
# Get these from Twitter Developer Portal
VITE_TWITTER_CLIENT_ID=your-twitter-client-id
VITE_TWITTER_REDIRECT_URI=http://localhost:5173/auth/twitter/callback

# Backend only (NOT exposed to frontend) - used by API routes
TWITTER_CLIENT_SECRET=your-twitter-client-secret

# --- Cloudflare Workers (Optional - Anti-Cheat) ---
VITE_CF_PRICE_ORACLE_URL=
VITE_CF_SESSION_VALIDATOR_URL=

# --- Zoho Mail SMTP (Optional) ---
ZOHO_SMTP_HOST=smtp.zoho.eu
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=

# --- Analytics (Optional) ---
VITE_ENABLE_ANALYTICS=true
VITE_METRICS_API_KEY=your-metrics-api-key-here

# --- Secret Keys (BACKEND ONLY - no VITE_ prefix) ---
ELEVENLABS_API_KEY=your-elevenlabs-key
GEMINI_API_KEY=your-gemini-key
