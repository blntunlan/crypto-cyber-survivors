# Supabase Configuration
# Get these from your Supabase project dashboard: https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Analytics Configuration (optional)
# Set to "false" to disable analytics tracking during development
# VITE_ENABLE_ANALYTICS=false

# ============================================================
# CLOUDFLARE WORKERS (Anti-Cheat System)
# ============================================================
# These are set up automatically via MCP, get URLs from Cloudflare Dashboard

# Price Oracle Worker URL (fetches and stores crypto prices)
# VITE_CF_PRICE_ORACLE_URL=https://crypto-price-oracle.your-account.workers.dev

# Session Validator Worker URL (validates game sessions)
# VITE_CF_SESSION_VALIDATOR_URL=https://crypto-session-validator.your-account.workers.dev

# ============================================================
# FEATURE FLAGS
# ============================================================
# Enable DevTools detection (set to false in development)
# VITE_ENABLE_DEVTOOLS_DETECTION=false
