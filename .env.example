# ============================================================
# CRYPTO SURVIVORS - ENVIRONMENT VARIABLES
# ============================================================
# IMPORTANT: Never commit actual values to Git. 
# Use .env or .env.local for local development.

# --- Supabase Configuration ---
# Get these from your Supabase project dashboard: https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Market Server Configuration ---
# The URL of your Railway market-server instance
VITE_MARKET_SERVER_URL=http://localhost:3001

# --- Market Runtime Mode ---
# legacy: current authority path
# dual: legacy authority + shadow runtime telemetry
# runtime: reserved for full runtime authority (Phase 0 still uses legacy fallback)
VITE_MARKET_RUNTIME_MODE=legacy

# Optional: Edge function endpoint for runtime tick/snapshot batch ingest
# Example: https://<project>.functions.supabase.co/ingest-run-market-batch
VITE_MARKET_SYNC_ENDPOINT=

# --- Analytics Configuration (optional) ---
VITE_ENABLE_ANALYTICS=true
VITE_METRICS_API_KEY=your-metrics-api-key-here

# --- Cloudflare Workers (Anti-Cheat System) ---
# Price Oracle Worker URL
VITE_CF_PRICE_ORACLE_URL=https://your-oracle.workers.dev
# Session Validator Worker URL
VITE_CF_SESSION_VALIDATOR_URL=https://your-validator.workers.dev

# --- Secret Keys (BACKEND ONLY) ---
# IMPORTANT: Do NOT use VITE_ prefix for these if they are only for Node.js scripts.
# These will be automatically excluded from the frontend bundle.
ELEVENLABS_API_KEY=your-elevenlabs-key
GEMINI_API_KEY=your-gemini-key

# --- Zoho Mail SMTP Configuration ---
# Set these up for sending emails via Zoho Mail (.eu region)
ZOHO_SMTP_HOST=smtp.zoho.eu
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=info@crypto-survivors.com
ZOHO_SMTP_PASS=your-app-specific-password-here

# --- Twitter OAuth 2.0 Configuration ---
# Get these from Twitter Developer Portal: https://developer.twitter.com/en/portal/dashboard
# 1. Create a project and app in the Developer Portal
# 2. Enable OAuth 2.0 in User authentication settings
# 3. Set callback URL to: https://your-domain.com/auth/twitter/callback
VITE_TWITTER_CLIENT_ID=your-twitter-client-id
VITE_TWITTER_REDIRECT_URI=http://localhost:5173/auth/twitter/callback

# Backend only (NOT exposed to frontend) - used by API routes
TWITTER_CLIENT_SECRET=your-twitter-client-secret
