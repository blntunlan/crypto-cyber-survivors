# ============================================================
# CRYPTO SURVIVORS - ENVIRONMENT VARIABLES
# ============================================================
# IMPORTANT: Never commit actual values to Git.
# Copy this file to .env and fill in real values for local development.

# --- Railway API ---
VITE_API_BASE_URL=https://your-api.up.railway.app
VITE_RAILWAY_API_URL=https://your-api.up.railway.app
VITE_MARKET_AGGREGATOR_URL=https://your-aggregator.up.railway.app

# --- App Environment ---
VITE_APP_ENV=development
VITE_ENABLE_DEBUG_API=false

# --- Market Runtime Mode ---
# legacy: current authority path
# dual: legacy authority + shadow runtime telemetry
# runtime: reserved for full runtime authority
VITE_MARKET_RUNTIME_MODE=legacy

# --- Beta Security Flags ---
# Beta/prod should keep durable rewards server-verified only.
VITE_VERIFY_COINS_ONLY=true
VITE_ANTI_CHEAT_SPEED_HACK_ENABLED=true

# --- Twitter OAuth 2.0 ---
# Get these from Twitter Developer Portal
VITE_TWITTER_CLIENT_ID=your-twitter-client-id
VITE_TWITTER_REDIRECT_URI=http://localhost:3000/auth/twitter/callback

# Backend OAuth secrets belong in railway-market-server/.env.example.
# Do not set TWITTER_CLIENT_SECRET on the frontend Railway service.

# --- Cloudflare Workers (Optional - Anti-Cheat) ---
VITE_CF_PRICE_ORACLE_URL=
VITE_CF_SESSION_VALIDATOR_URL=

# --- Zoho Mail SMTP (Optional) ---
ZOHO_SMTP_HOST=smtp.zoho.eu
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=
ZOHO_SMTP_PASS=

# --- Analytics (Optional) ---
VITE_ENABLE_ANALYTICS=true
VITE_METRICS_ENABLED=true
VITE_METRICS_REMOTE_ENDPOINT=
VITE_METRICS_API_KEY=your-metrics-api-key-here

# --- Runtime Diagnostics (Optional) ---
VITE_RUNTIME_DIAGNOSTICS_ENABLED=false
VITE_RUNTIME_DIAGNOSTICS_FRAME_BUFFER=180

# --- Secret Keys (BACKEND ONLY - no VITE_ prefix) ---
ELEVENLABS_API_KEY=your-elevenlabs-key
GEMINI_API_KEY=your-gemini-key
