# Railway Market Server - Environment Variables
# Copy this file to .env and fill in the values

# PostgreSQL (Required) - Railway-provided DATABASE_URL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Railway-native API auth (Required for /api/v1/auth/anonymous)
API_JWT_SECRET=replace-with-a-long-random-secret
API_JWT_EXPIRES_SECONDS=2592000
TOKEN_ENCRYPTION_SECRET=replace-with-a-long-random-secret

# Twitter OAuth 2.0 (Required for /api/auth/twitter/* endpoints)
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret

# Admin API Secret (Required for beta/prod /api/v1/admin/* endpoints)
ADMIN_API_SECRET=your-admin-secret-here

# Node Environment (production in beta/prod)
NODE_ENV=development

# Server Port (optional, defaults to 3001)
PORT=3001

# --- Database tuning (optional) ---
# Pool size for this service (default 10). Budget rule: sum of
# (PG_POOL_MAX x replicas) across ALL services (aggregator default is 5)
# should stay well under Postgres max_connections (Railway default 100).
# PG_POOL_MAX=10

# TLS to Postgres: disable | require | verify-full.
# Unset = auto: no TLS on *.railway.internal, TLS without CA verification on
# *.railway.app / *.rlwy.net public endpoints.
# DATABASE_SSL=

# Materialized leaderboard refresh interval in ms (min 30000, default 120000)
# LEADERBOARD_REFRESH_MS=120000
