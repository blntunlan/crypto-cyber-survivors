# Railway Market Server - Environment Variables
# Copy this file to .env and fill in the values

# PostgreSQL (Required) - Railway-provided DATABASE_URL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Supabase Auth Verification
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Twitter OAuth 2.0 (Required for /api/auth/twitter/* endpoints)
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret

# Supabase Webhook Secret (optional — for auth event webhooks)
SUPABASE_WEBHOOK_SECRET=your-webhook-secret-here

# Admin API Secret (optional — for /api/v1/admin/* endpoints)
ADMIN_API_SECRET=your-admin-secret-here

# Server Port (optional, defaults to 3001)
PORT=3001
