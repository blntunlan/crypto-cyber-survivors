# Railway Market Server - Environment Variables
# Copy this file to .env and fill in the values

# PostgreSQL (Required) — Railway-provided DATABASE_URL
DATABASE_URL=postgresql://user:password@host:port/dbname

# Supabase JWT Secret (Required) — For verifying client auth tokens
# Found in Supabase Dashboard > Project Settings > API > JWT Secret
SUPABASE_JWT_SECRET=your_jwt_secret_here

# Server Port (optional, defaults to 3001)
PORT=3001

# --- Twitter OAuth 2.0 (Required for /api/auth/twitter/* endpoints) ---
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret
