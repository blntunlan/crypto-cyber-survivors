{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "providers": [
        "node"
      ],
      "phases": {
        "setup": {
          "nixPkgs": [
            "nodejs_22",
            "npm"
          ]
        },
        "install": {
          "cmds": [
            "npm ci"
          ]
        },
        "build": {
          "cmds": [
            "npm run build"
          ]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "npm start",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}