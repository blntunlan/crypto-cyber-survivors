{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/railway-market-aggregator/src/**",
      "/railway-market-aggregator/package.json",
      "/railway-market-aggregator/package-lock.json",
      "/railway-market-aggregator/tsconfig.json",
      "/railway-market-aggregator/Dockerfile",
      "/railway-market-aggregator/.dockerignore",
      "/railway-market-aggregator/railway.json"
    ]
  },
  "deploy": {
    "startCommand": "node dist/index.js",
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/health",
    "numReplicas": 1,
    "region": "europe-west4",
    "restartPolicyMaxRetries": 3
  }
}
