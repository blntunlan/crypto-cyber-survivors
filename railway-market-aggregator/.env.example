# Railway Market Aggregator - Environment Variables
# Copy this file to .env and fill in the values

# PostgreSQL (Required) - Railway-provided DATABASE_URL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Server Port (optional, defaults to 3002)
PORT=3002

# Node Environment
NODE_ENV=development

# --- Database tuning (optional) ---
# Pool size for this service (default 5). Budget rule: sum of
# (PG_POOL_MAX x replicas) across ALL services (API server default is 10)
# should stay well under Postgres max_connections (Railway default 100).
# PG_POOL_MAX=5

# TLS to Postgres: disable | require | verify-full.
# Unset = auto: no TLS on *.railway.internal, TLS without CA verification on
# *.railway.app / *.rlwy.net public endpoints.
# DATABASE_SSL=
