{
  "name": "railway-market-aggregator",
  "version": "1.0.3",
  "description": "Real-time crypto market data aggregator (WebSocket + SSE + Indicators)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "prebuild": "npm run typecheck && npm run lint",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "pg": "^8.20.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.18.0",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
