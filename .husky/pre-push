# Pre-push hook: Validate project before pushing
# This prevents broken deployments and ensures cross-platform stability

echo "🚀 Pre-push validation..."

# 1. Validate Main Application
echo "📦 Validating Main Application..."
npm run build || {
  echo "❌ Main Application build failed! Fix errors before pushing."
  exit 1
}

# 2. Validate railway-market-server if changed
CHANGED_FILES=$(git diff --cached --name-only HEAD~1 2>/dev/null || git diff --name-only HEAD~1 2>/dev/null || echo "")

if echo "$CHANGED_FILES" | grep -q "^railway-market-server/"; then
  echo "📦 Railway Market Server changes detected, running validation..."
  
  cd railway-market-server
  
  # Install dependencies if needed
  if [ ! -d "node_modules" ]; then
    echo "📥 Installing dependencies..."
    npm ci --silent
  fi
  
  # Run type check
  echo "🔍 Type checking..."
  npm run typecheck || {
    echo "❌ TypeScript errors found! Fix them before pushing."
    exit 1
  }
  
  # Run build
  echo "🔨 Building..."
  npm run build || {
    echo "❌ Build failed! Fix errors before pushing."
    exit 1
  }
  
  echo "✅ Railway Market Server validation passed!"
  cd ..
fi

echo "✅ All pre-push checks complete!"

