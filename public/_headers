# =============================================================================
# Crypto Survivors - Security Headers (Hardened)
# These headers are applied to all responses from Cloudflare/Railway
# =============================================================================

/*
  # Prevent clickjacking attacks
  X-Frame-Options: DENY
  
  # Prevent MIME type sniffing
  X-Content-Type-Options: nosniff
  
  # Enable browser XSS filter
  X-XSS-Protection: 1; mode=block
  
  # Control referrer information
  Referrer-Policy: strict-origin-when-cross-origin
  
  # Disable unnecessary browser features (comprehensive)
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), ambient-light-sensor=(), autoplay=(self), encrypted-media=(self), fullscreen=(self)
  
  # Enable HTTPS (HSTS) - 2 years with preload
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  
  # Prevent DNS prefetch to third parties
  X-DNS-Prefetch-Control: off
  
  # Cross-Origin policies
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  Cross-Origin-Resource-Policy: same-origin

# HTML pages - strict CSP (no unsafe-eval in production)
/*.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' wss://stream.binance.com wss://ws-feed.exchange.coinbase.com https://*.supabase.co https://*.workers.dev; media-src 'self' blob: data:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

/
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' wss://stream.binance.com wss://ws-feed.exchange.coinbase.com https://*.supabase.co https://*.workers.dev; media-src 'self' blob: data:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

# Obfuscated static assets - aggressive caching, no CORS
/a/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Legacy assets path (redirect to /a/)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts - aggressive caching
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Images - moderate caching
/images/*
  Cache-Control: public, max-age=86400

/icons/*
  Cache-Control: public, max-age=86400

# Localization files - short cache (may change)
/locales/*
  Cache-Control: public, max-age=3600

# Documentation - moderate caching
/docs/*
  Cache-Control: public, max-age=3600

# Service Worker - no cache
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Manifest - short cache
/manifest.json
  Cache-Control: public, max-age=3600
