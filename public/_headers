# =============================================================================
# Crypto Survivors - Security Headers
# These headers are applied to all responses from Cloudflare/Railway
# =============================================================================

/*
  # Prevent clickjacking attacks
  X-Frame-Options: SAMEORIGIN
  
  # Prevent MIME type sniffing
  X-Content-Type-Options: nosniff
  
  # Enable browser XSS filter
  X-XSS-Protection: 1; mode=block
  
  # Control referrer information
  Referrer-Policy: strict-origin-when-cross-origin
  
  # Disable unnecessary browser features
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  
  # Enable HTTPS (HSTS)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# HTML pages - more restrictive CSP
/*.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' wss: https: ws:; media-src 'self' blob: data:; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

/
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' wss: https: ws:; media-src 'self' blob: data:; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

# Static assets - aggressive caching
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts - aggressive caching
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Images - moderate caching
/images/*
  Cache-Control: public, max-age=86400

/icons/*
  Cache-Control: public, max-age=86400

# Localization files - short cache (may change)
/locales/*
  Cache-Control: public, max-age=3600

# Documentation - moderate caching
/docs/*
  Cache-Control: public, max-age=3600

# Service Worker - no cache
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# Manifest - short cache
/manifest.json
  Cache-Control: public, max-age=3600
