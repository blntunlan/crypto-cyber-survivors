# =============================================================================
# Crypto Survivors - Security Headers (Hardened)
# These headers are applied to all responses from Cloudflare/Railway
# =============================================================================

/*
  # Prevent clickjacking attacks
  X-Frame-Options: DENY
  
  # Prevent MIME type sniffing
  X-Content-Type-Options: nosniff
  
  # Enable browser XSS filter
  X-XSS-Protection: 1; mode=block
  
  # Control referrer information
  Referrer-Policy: strict-origin-when-cross-origin
  
  # Disable unnecessary browser features (comprehensive)
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), autoplay=(self), encrypted-media=(self), fullscreen=(self)
  
  # Enable HTTPS (HSTS) - 2 years with preload
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  
  # Prevent DNS prefetch to third parties
  X-DNS-Prefetch-Control: off
  
  # Cross-Origin policies
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  Cross-Origin-Resource-Policy: same-origin

# HTML pages - strict CSP (allow necessary external sources)
/*.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://fonts.googleapis.com data:; img-src 'self' data: blob: https://www.transparenttextures.com https://*.supabase.co https://lh3.googleusercontent.com https://avatars.githubusercontent.com https://cdn.discordapp.com; connect-src 'self' wss://stream.binance.com wss://stream.binance.com:9443 wss://ws-feed.exchange.coinbase.com wss://stream.coinbase.com wss://*.coinbase.com https://*.supabase.co wss://*.supabase.co https://*.supabase.com https://*.workers.dev https://*.up.railway.app https://cloudflareinsights.com; media-src 'self' blob: data:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

/
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://static.cloudflareinsights.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://fonts.googleapis.com data:; img-src 'self' data: blob: https://www.transparenttextures.com https://*.supabase.co https://lh3.googleusercontent.com https://avatars.githubusercontent.com https://cdn.discordapp.com; connect-src 'self' wss://stream.binance.com wss://stream.binance.com:9443 wss://ws-feed.exchange.coinbase.com wss://stream.coinbase.com wss://*.coinbase.com https://*.supabase.co wss://*.supabase.co https://*.supabase.com https://*.workers.dev https://*.up.railway.app https://cloudflareinsights.com; media-src 'self' blob: data:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

# Obfuscated static assets - aggressive caching, no CORS
/a/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex

# Legacy assets path (redirect to /a/)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts - aggressive caching
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Images - moderate caching
/images/*
  Cache-Control: public, max-age=86400

/icons/*
  Cache-Control: public, max-age=86400

# Localization files - short cache (may change)
/locales/*
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex

# Documentation - moderate caching
/docs/*
  Cache-Control: public, max-age=3600

/docs/*.md
  X-Robots-Tag: noindex

/docs/navigation.json
  X-Robots-Tag: noindex

# Service Worker - no cache
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  X-Robots-Tag: noindex

# Manifest - short cache
/manifest.json
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex

/README.md
  X-Robots-Tag: noindex

